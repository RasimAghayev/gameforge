# .env.example

# GameForge configuration (placeholders only — never commit real values)

# Server
SERVER_PORT=8080
SERVER_ENV=development

# PostgreSQL (config / rules)
PG_HOST=postgres
PG_PORT=5432
PG_USER=gameforge
PG_PASSWORD=changeme
PG_DB=gameforge

# MongoDB (events / history)
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USER=gameforge
MONGO_PASSWORD=changeme
MONGO_DB=gameforge

# Redis (leaderboards / cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# NATS JetStream (event bus)
NATS_URL=nats://nats:4222

# Auth
JWT_SECRET=changeme-jwt-secret
API_KEY_PREFIX=gf_

# Tenant isolation
TENANT_ISOLATION=enabled
